{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Motion Workshop project v2 (1.4 layers and audio extension)",
  "type": "object",
  "required": [
    "version",
    "clips"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 2
    },
    "ratio": {
      "enum": [
        "16:9",
        "9:16",
        "1:1"
      ],
      "default": "16:9"
    },
    "quality": {
      "enum": [
        720,
        1080
      ],
      "default": 720
    },
    "fps": {
      "enum": [
        30,
        60
      ],
      "default": 30
    },
    "clips": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": {
        "type": "object",
        "required": [
          "effect"
        ],
        "additionalProperties": false,
        "properties": {
          "effect": {
            "enum": [
              "bounce",
              "type",
              "morph",
              "clay",
              "rhythm",
              "flow",
              "glass",
              "tunnel",
              "particles",
              "reaction",
              "halftone",
              "physics",
              "mask-reveal",
              "kinetic-zoom",
              "text-morph",
              "number-roll",
              "typewriter",
              "card-flyin",
              "card-flip",
              "orbit-cards",
              "bento-grid",
              "chart-build",
              "path-draw",
              "phone-scroll",
              "tab-indicator",
              "cursor-click",
              "glass-card",
              "beat-sync",
              "line-chart",
              "donut-chart",
              "network-flow",
              "timeline-story",
              "code-window",
              "terminal-run",
              "logo-reveal",
              "split-title",
              "quote-card",
              "gradient-mesh",
              "isometric-stack",
              "notification-stack",
              "mp-001",
              "mp-002",
              "mp-003",
              "mp-004",
              "mp-005",
              "mp-006",
              "mp-007",
              "mp-008",
              "mp-009",
              "mp-010",
              "mp-011",
              "mp-012",
              "mp-013",
              "mp-014",
              "mp-015",
              "mp-016",
              "mp-017",
              "mp-018",
              "mp-019",
              "mp-020",
              "mp-021",
              "mp-022",
              "mp-023",
              "mp-024",
              "mp-025",
              "mp-026",
              "mp-027",
              "mp-028",
              "mp-029",
              "mp-030",
              "mp-031",
              "mp-032",
              "mp-033",
              "mp-034",
              "mp-035",
              "mp-036",
              "mp-037",
              "mp-038",
              "mp-039",
              "mp-040",
              "mp-041",
              "mp-042",
              "mp-043",
              "mp-044",
              "mp-045",
              "mp-046",
              "mp-047",
              "mp-048",
              "mp-049",
              "mp-050",
              "mp-051",
              "mp-052",
              "mp-053",
              "mp-054",
              "mp-055",
              "mp-056",
              "mp-057",
              "mp-058",
              "mp-059",
              "mp-060",
              "mp-061",
              "mp-062",
              "mp-063",
              "mp-064",
              "mp-065",
              "mp-066",
              "mp-067",
              "mp-068",
              "mp-069",
              "mp-070",
              "mp-071",
              "mp-072",
              "mp-073",
              "mp-074",
              "mp-075",
              "mp-076",
              "mp-077",
              "mp-078",
              "mp-079",
              "mp-080",
              "mp-081",
              "mp-082",
              "mp-083",
              "mp-084",
              "mp-085",
              "mp-086",
              "mp-087",
              "mp-088",
              "mp-089",
              "mp-090",
              "mp-091",
              "mp-092",
              "mp-093",
              "mp-094",
              "mp-095",
              "mp-096",
              "mp-097",
              "mp-098",
              "mp-099",
              "mp-100",
              "mp-101",
              "mp-102",
              "mp-103",
              "mp-104",
              "mp-105",
              "mp-106",
              "mp-107",
              "mp-108",
              "mp-109",
              "mp-110",
              "mp-111",
              "mp-112",
              "mp-113",
              "mp-114",
              "mp-115",
              "mp-116",
              "mp-117",
              "mp-118",
              "mp-119",
              "mp-120",
              "mp-121",
              "mp-122",
              "mp-123",
              "mp-124",
              "mp-125",
              "mp-126",
              "mp-127",
              "mp-128",
              "mp-129",
              "mp-130",
              "mp-131",
              "mp-132",
              "mp-133",
              "mp-134",
              "mp-135",
              "mp-136",
              "mp-137",
              "mp-138",
              "mp-139",
              "mp-140",
              "mp-141",
              "mp-142",
              "mp-143",
              "mp-144"
            ]
          },
          "text": {
            "type": "string",
            "maxLength": 60
          },
          "subtitle": {
            "type": "string",
            "maxLength": 80
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "secondary": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "background": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "speed": {
            "type": "number",
            "minimum": 0.25,
            "maximum": 2.5
          },
          "size": {
            "type": "number",
            "minimum": 0.6,
            "maximum": 1.5
          },
          "amount": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "duration": {
            "type": "number",
            "minimum": 1,
            "maximum": 20
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 6,
            "items": {
              "type": "string",
              "maxLength": 24
            }
          },
          "values": {
            "type": "array",
            "minItems": 1,
            "maxItems": 6,
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000000
            }
          },
          "value": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000000000
          },
          "suffix": {
            "type": "string",
            "maxLength": 12
          },
          "bpm": {
            "type": "number",
            "minimum": 40,
            "maximum": 240
          },
          "transition": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "enum": [
                  "cut",
                  "crossfade",
                  "push",
                  "wipe",
                  "circle",
                  "zoom",
                  "slide-up",
                  "diagonal",
                  "blur",
                  "flash"
                ]
              },
              "duration": {
                "type": "number",
                "minimum": 0.1,
                "maximum": 1.5
              }
            }
          },
          "base": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "visible": {
                "type": "boolean"
              },
              "x": {
                "type": "number",
                "minimum": -100,
                "maximum": 200
              },
              "y": {
                "type": "number",
                "minimum": -100,
                "maximum": 200
              },
              "scale": {
                "type": "number",
                "minimum": 0.05,
                "maximum": 5
              },
              "rotation": {
                "type": "number",
                "minimum": -1080,
                "maximum": 1080
              },
              "opacity": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          },
          "layers": {
            "type": "array",
            "maxItems": 12,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "maxLength": 64
                },
                "name": {
                  "type": "string",
                  "maxLength": 40
                },
                "type": {
                  "enum": [
                    "text",
                    "rect",
                    "ellipse",
                    "line",
                    "image"
                  ]
                },
                "visible": {
                  "type": "boolean"
                },
                "locked": {
                  "type": "boolean"
                },
                "text": {
                  "type": "string",
                  "maxLength": 400
                },
                "image": {
                  "type": "string",
                  "maxLength": 2000000,
                  "pattern": "^$|^data:image/(png|jpeg|webp);base64,[A-Za-z0-9+/=]+$"
                },
                "fill": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                },
                "stroke": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                },
                "strokeWidth": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 30
                },
                "width": {
                  "type": "number",
                  "minimum": 1,
                  "maximum": 200
                },
                "height": {
                  "type": "number",
                  "minimum": 1,
                  "maximum": 200
                },
                "radius": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                "fontSize": {
                  "type": "number",
                  "minimum": 1,
                  "maximum": 50
                },
                "fontFamily": {
                  "enum": [
                    "sans",
                    "serif",
                    "mono"
                  ]
                },
                "weight": {
                  "enum": [
                    400,
                    700,
                    900
                  ]
                },
                "align": {
                  "enum": [
                    "left",
                    "center",
                    "right"
                  ]
                },
                "blend": {
                  "enum": [
                    "source-over",
                    "multiply",
                    "screen",
                    "overlay"
                  ]
                },
                "start": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 20
                },
                "end": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 20
                },
                "transform": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "x": {
                      "type": "number",
                      "minimum": -100,
                      "maximum": 200
                    },
                    "y": {
                      "type": "number",
                      "minimum": -100,
                      "maximum": 200
                    },
                    "scale": {
                      "type": "number",
                      "minimum": 0.05,
                      "maximum": 5
                    },
                    "rotation": {
                      "type": "number",
                      "minimum": -1080,
                      "maximum": 1080
                    },
                    "opacity": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  }
                },
                "keyframes": {
                  "type": "array",
                  "maxItems": 60,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "time": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 20
                      },
                      "x": {
                        "type": "number",
                        "minimum": -100,
                        "maximum": 200
                      },
                      "y": {
                        "type": "number",
                        "minimum": -100,
                        "maximum": 200
                      },
                      "scale": {
                        "type": "number",
                        "minimum": 0.05,
                        "maximum": 5
                      },
                      "rotation": {
                        "type": "number",
                        "minimum": -1080,
                        "maximum": 1080
                      },
                      "opacity": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "easing": {
                        "enum": [
                          "linear",
                          "ease-in",
                          "ease-out",
                          "ease-in-out",
                          "back",
                          "bounce",
                          "step"
                        ]
                      }
                    },
                    "required": [
                      "time"
                    ]
                  }
                }
              },
              "required": [
                "type"
              ]
            }
          },
          "audio": {
            "type": "array",
            "maxItems": 12,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "sound": {
                  "enum": [
                    "click",
                    "soft-click",
                    "select",
                    "confirm",
                    "open",
                    "close",
                    "expand",
                    "shrink",
                    "drop",
                    "bell",
                    "pluck",
                    "switch",
                    "toggle",
                    "tick",
                    "error",
                    "scroll"
                  ]
                },
                "time": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 20
                },
                "volume": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 2
                },
                "rate": {
                  "type": "number",
                  "minimum": 0.5,
                  "maximum": 2
                },
                "fadeIn": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 2
                },
                "fadeOut": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 2
                }
              },
              "required": [
                "sound"
              ]
            }
          },
          "reference": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "library",
              "id",
              "kind"
            ],
            "properties": {
              "library": {
                "const": "motion-prompt"
              },
              "id": {
                "type": "string",
                "pattern": "^(00[1-9]|0[1-9][0-9]|1[0-3][0-9]|14[0-4])$"
              },
              "kind": {
                "enum": [
                  "workshop-recipe",
                  "original-template"
                ]
              },
              "sourceCommit": {
                "type": "string",
                "pattern": "^([a-f0-9]{40})?$"
              }
            }
          },
          "referenceTemplate": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "fit": {
                "enum": [
                  "contain",
                  "cover"
                ]
              },
              "labels": {
                "type": "boolean"
              },
              "loop": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "volume": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  }
}
